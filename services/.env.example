# Required
SECRET_KEY=change-me

# PostgreSQL credentials shared by the database and backend containers
POSTGRES_DB=transcendence
POSTGRES_USER=transcendence
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=database
POSTGRES_PORT=5432

# true/1 enables debug
DEBUG=False

# Comma-separated hosts Django accepts from the Host header
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Comma-separated public HTTPS origins allowed for CSRF checks
CSRF_TRUSTED_ORIGINS=https://localhost:4443
